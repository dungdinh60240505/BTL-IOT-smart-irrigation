        <div class="view-section" id="view-management">
            <div class="manage-heading">
                <div>
                    <h2>Telemetry thời gian thực</h2>
                    <p>Dữ liệu mới được đồng bộ từ các thiết bị đang theo dõi.</p>
                </div>
            </div>
            <p class="manage-status" id="management-status" role="status"></p>

            <section class="card">
                <div class="manage-toolbar" style="margin-bottom: 14px;">
                    <div class="card-title-group">
                        <span class="material-symbols-outlined">sensors</span>
                        <h3 class="card-title">Telemetry thời gian thực</h3>
                    </div>
                    <span class="live-indicator" id="telemetry-live-status">Đang kết nối...</span>
                </div>
                <div class="telemetry-toolbar">
                    <label for="telemetry-device-filter">Thiết bị
                        <select class="manage-select" id="telemetry-device-filter"><option value="">Tất cả thiết bị</option></select>
                    </label>
                    <span class="manage-hint">50 bản ghi mới nhất</span>
                </div>
                <div class="manage-table-wrap">
                    <table class="manage-table">
                        <thead><tr><th>Thời gian</th><th>Thiết bị</th><th>Nhiệt độ (°C)</th><th>Độ ẩm không khí (%)</th><th>Độ ẩm đất (%)</th><th>Mực nước (%)</th></tr></thead>
                        <tbody id="telemetry-table-body"><tr><td class="manage-empty" colspan="6">Chưa có dữ liệu telemetry.</td></tr></tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- View Settings -->
        <div class="view-section" id="view-settings">
            <h2 style="margin-bottom: 24px; color: var(--primary);">Cài đặt thông số</h2>
            <div class="card">
                <h3 style="margin-bottom: 16px; color: var(--primary);">Cấu hình Ngưỡng (Thresholds)</h3>
                
                <div class="sim-grid">
                    <div class="sim-slider-group">
                        <div class="sim-slider-header">
                            <span class="sim-slider-label">Ngưỡng độ ẩm đất (cần tưới)</span>
                            <span class="sim-slider-val" id="val-set-soil">40%</span>
                        </div>
                        <input type="range" id="set-soil" min="0" max="100" value="40">
                        <button class="sidebar-action-btn" style="margin-top: 12px; width: auto;" onclick="saveSetting('soil')">Lưu Ngưỡng Đất</button>
                    </div>

                    <div class="sim-slider-group">
                        <div class="sim-slider-header">
                            <span class="sim-slider-label">Ngưỡng nhiệt độ (cảnh báo)</span>
                            <span class="sim-slider-val" id="val-set-temp">35°C</span>
                        </div>
                        <input type="range" class="error" id="set-temp" min="20" max="60" value="35" step="0.5">
                        <button class="sidebar-action-btn" style="background: var(--error); margin-top: 12px; width: auto;" onclick="saveSetting('temp')">Lưu Ngưỡng Nhiệt độ</button>
