    </main>

    <dialog class="manage-dialog" id="manage-dialog">
        <form id="manage-form">
            <div class="manage-dialog-header"><h3 id="manage-dialog-title">Thêm</h3></div>
            <div class="manage-dialog-body" id="manage-dialog-fields"></div>
            <div class="manage-dialog-footer">
                <button class="manage-action secondary" type="button" data-action="cancel-dialog">Hủy</button>
                <button class="manage-action" type="submit"><span class="material-symbols-outlined">save</span> Lưu</button>
            </div>
        </form>
    </dialog>

    <dialog class="manage-dialog sensor-picker-dialog" id="sensor-picker-dialog" aria-labelledby="sensor-picker-title">
        <div class="manage-dialog-header"><h3 id="sensor-picker-title">Thêm cảm biến</h3></div>
        <div class="manage-dialog-body sensor-picker-body">
            <p class="sensor-picker-summary">Đã chọn <strong id="sensor-selection-count">0</strong> thiết bị. Thiết bị đang thuộc cây khác sẽ được chuyển sang cây này khi lưu.</p>
            <div class="manage-table-wrap">
                <table class="manage-table">
                    <thead><tr><th>Thiết bị</th><th>Device ID</th><th>Đang gán cho</th><th>Kết nối</th><th></th></tr></thead>
                    <tbody id="sensor-picker-body"><tr><td class="manage-empty" colspan="5">Đang tải thiết bị...</td></tr></tbody>
                </table>
            </div>
        </div>
        <div class="manage-dialog-footer">
            <button class="manage-action secondary" type="button" data-action="cancel-sensor-picker">Hủy</button>
            <button class="manage-action" type="button" data-action="save-sensor-picker"><span class="material-symbols-outlined">save</span> Lưu</button>
        </div>
    </dialog>

    <dialog class="manage-dialog" id="profile-dialog" aria-labelledby="profile-dialog-title">
        <div class="manage-dialog-header"><h3 id="profile-dialog-title">Thông tin cá nhân</h3></div>
        <div class="manage-dialog-body">
            <dl class="profile-details">
                <div><dt>Tên đăng nhập</dt><dd id="profile-username">Đang tải...</dd></div>
                <div><dt>Trạng thái</dt><dd id="profile-status">Đang tải...</dd></div>
                <div><dt>Ngày tạo</dt><dd id="profile-created">Đang tải...</dd></div>
            </dl>
        </div>
        <div class="manage-dialog-footer">
            <button class="manage-action secondary" type="button" data-account-action="close-profile">Đóng</button>
        </div>
    </dialog>

    <script>
        // ========== NAVIGATION LOGIC ==========
        const navItems = document.querySelectorAll('.nav-item[data-target]');
        const viewSections = document.querySelectorAll('.view-section');
        
        navItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                navItems.forEach(nav => nav.classList.remove('active'));
                item.classList.add('active');
                
                const targetId = item.getAttribute('data-target');
                viewSections.forEach(view => {
                    view.classList.remove('active');
                });
                const targetView = document.getElementById(targetId);
                if(targetView) targetView.classList.add('active');
            });
        });

        // ========== DOM ==========
        const $ = id => document.getElementById(id);
        const accountMenu = $('account-menu');
        const accountMenuToggle = $('account-menu-toggle');
        const accountDropdown = $('account-dropdown');
        const profileDialog = $('profile-dialog');

        function setAccountMenuOpen(open) {
            accountDropdown.hidden = !open;
            accountMenuToggle.setAttribute('aria-expanded', String(open));
        }

        accountMenuToggle.addEventListener('click', () => {
            setAccountMenuOpen(accountDropdown.hidden);
        });

        document.addEventListener('click', event => {
            if (!accountMenu.contains(event.target)) setAccountMenuOpen(false);
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && !accountDropdown.hidden) {
                setAccountMenuOpen(false);
                accountMenuToggle.focus();
            }
        });

        async function showProfile() {
            setAccountMenuOpen(false);
            try {
                const response = await fetch('/api/auth/me');
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Khong the tai thong tin tai khoan');
                const user = result.user;
                $('account-menu-username').textContent = user.username;
                accountMenuToggle.textContent = user.username.slice(0, 2).toUpperCase();
                accountMenuToggle.setAttribute('aria-label', `Tài khoản ${user.username}`);
                $('profile-username').textContent = user.username;
                $('profile-status').textContent = user.status_online ? 'Đang hoạt động' : 'Ngoại tuyến';
                $('profile-created').textContent = user.createdAt ? new Date(user.createdAt).toLocaleString('vi-VN') : '—';
                profileDialog.showModal();
            } catch {
                window.location.assign('/login');
            }
        }

        document.addEventListener('click', event => {
            const action = event.target.closest('[data-account-action]')?.dataset.accountAction;
            if (action === 'profile') showProfile();
            else if (action === 'close-profile') profileDialog.close();
        });

        // ========== NOTIFICATIONS ==========
        const notifBtn = $('notif-btn');
        const notifDropdown = $('notification-dropdown');
        const notifList = $('notification-list');
        const notifClear = $('notification-clear');
        const notifLabels = {
            SOIL_LOW: 'Độ ẩm đất thấp',
            SOIL_HIGH: 'Độ ẩm đất cao',
            WATER_LOW: 'Mực nước thấp',
            WATER_HIGH: 'Mực nước cao',
        };

        function renderNotifications(items) {
            const list = Array.isArray(items) ? items : [];
            const unread = list.filter(item => !item.read).length;
            $('notif-dot').style.display = unread > 0 ? 'block' : 'none';
            notifClear.style.display = unread > 0 ? 'inline' : 'none';
            if (!list.length) {
                notifList.innerHTML = '<p class="notification-empty">Chưa có thông báo.<br>Hệ thống sẽ tạo thông báo khi độ ẩm đất hoặc mực nước vượt ngưỡng.</p>';
                return;
            }
            notifList.innerHTML = list.map(item => `
                <button class="notification-item ${item.read ? '' : 'unread'}" type="button" data-notification-id="${escapeHtml(item._id)}">
                    <span class="notification-item-title">
                        ${item.active ? '🔴' : '⚪'} ${escapeHtml(notifLabels[item.type] || item.type)}
                        ${item.read ? '' : '<span style="color:var(--error);font-size:10px">Mới</span>'}
                        ${item.active ? '' : '<span style="color:var(--outline);font-size:10px">Đã hết</span>'}
                    </span>
                    <span class="notification-item-message">${escapeHtml(item.message || '')}</span>
                    <span class="notification-item-meta">${escapeHtml(item.deviceId || '')} · ${escapeHtml(formatDate(item.createdAt))}</span>
                </button>
            `).join('');
        }

        async function loadNotifications() {
            try {
                const items = await apiRequest('/api/notifications?limit=50');
                renderNotifications(items);
            } catch (error) {
                notifList.innerHTML = `<p class="notification-empty">${escapeHtml(error.message || 'Không tải được thông báo')}</p>`;
            }
        }

        notifBtn.addEventListener('click', async (event) => {
            event.stopPropagation();
            const willOpen = notifDropdown.hidden;
            notifDropdown.hidden = !willOpen;
            notifBtn.setAttribute('aria-expanded', String(willOpen));
            if (willOpen) await loadNotifications();
        });

        notifList.addEventListener('click', async (event) => {
            const button = event.target.closest('[data-notification-id]');
            if (!button) return;
            try {
                await apiRequest(`/api/notifications/${encodeURIComponent(button.dataset.notificationId)}/read`, { method: 'PATCH' });
                await loadNotifications();
            } catch (error) {
                console.error('Không đánh dấu được thông báo:', error);
            }
        });

        notifClear.addEventListener('click', async (event) => {
            event.stopPropagation();
            try {
                await apiRequest('/api/notifications/read-all', { method: 'PATCH' });
                await loadNotifications();
            } catch (error) {
                console.error('Không đánh dấu được tất cả thông báo:', error);
            }
        });

        document.addEventListener('click', event => {
            if (!event.target.closest('.notification-menu')) {
                notifDropdown.hidden = true;
                notifBtn.setAttribute('aria-expanded', 'false');
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            loadNotifications();
            window.setInterval(loadNotifications, 15000);
        });

        const modeSwitch = $('mode-switch');
        const swPump = $('sw-pump');
        const swLed = $('sw-led');
        const controlsModeSwitch = $('controls-mode-switch');
        const controlsPumpSwitch = $('controls-pump-switch');
        const controlsLedSwitch = $('controls-led-switch');

        let isPumpOn = false;
        let isLedOn = false;
        let isAutoMode = true;

        function syncControlSwitches() {
            controlsModeSwitch.checked = isAutoMode;
            controlsPumpSwitch.checked = isPumpOn;
            controlsLedSwitch.checked = isLedOn;
        }

        // Start with auto → switches are read-only
        swPump.style.pointerEvents = 'none';
        swLed.style.pointerEvents = 'none';
        syncControlSwitches();

        async function sendLampCommand(isOn) {
            try {
                await apiRequest('/api/devices/esp32_01/command', {
                    method: 'POST',
                    body: JSON.stringify({ action: 'LAMP', state: isOn ? 'ON' : 'OFF' })
                });
                addLog(`Đã gửi lệnh đèn: ${isOn ? 'bật' : 'tắt'}.`, 'success');
                return true;
            } catch (error) {
                addLog(`Không gửi được lệnh đèn: ${error.message}.`, 'warning');
                return false;
            }
        }

        async function sendWaterCommand(isOn) {
            try {
                await apiRequest('/api/devices/esp32_01/command', {
                    method: 'POST',
                    body: JSON.stringify({ action: 'WATER', state: isOn ? 'ON' : 'OFF' })
                });
                addLog(`Đã gửi lệnh bơm: ${isOn ? 'bật' : 'tắt'}.`, 'success');
                return true;
            } catch (error) {
                addLog(`Không gửi được lệnh bơm: ${error.message}.`, 'warning');
                return false;
            }
        }

        // ========== MODE & CONTROL ==========
        modeSwitch.addEventListener('change', () => {
            isAutoMode = modeSwitch.checked;
            $('mode-label').textContent = isAutoMode ? 'Tự động' : 'Thủ công';
            $('led-auto-badge').textContent = isAutoMode ? 'Tự động' : 'Thủ công';
            $('led-auto-badge').style.background = isAutoMode
                ? 'var(--primary-container)' : 'var(--tertiary-fixed)';
            $('led-auto-badge').style.color = isAutoMode
                ? 'var(--on-primary-container)' : 'var(--tertiary)';

            if (!isAutoMode) {
                swPump.style.pointerEvents = 'auto';
                swLed.style.pointerEvents = 'auto';
            } else {
                swPump.style.pointerEvents = 'none';
                swLed.style.pointerEvents = 'none';
            }
            syncControlSwitches();
            addLog(`Che do hien tai: ${isAutoMode ? 'Tu dong' : 'Thu cong'} (chi luu tren giao dien).`, 'info');
        });

        swPump.addEventListener('change', async () => {
            if (isAutoMode) {
                swPump.checked = isPumpOn;
                return;
            }

            const requestedState = swPump.checked;
            const previousState = isPumpOn;
            isPumpOn = requestedState;
            syncControlSwitches();
            if (!await sendWaterCommand(requestedState) && isPumpOn === requestedState) {
                isPumpOn = previousState;
                swPump.checked = previousState;
                syncControlSwitches();
            }
        });
        swLed.addEventListener('change', async () => {
            if (isAutoMode) {
                swLed.checked = isLedOn;
                return;
            }
            const requestedState = swLed.checked;
            const previousState = isLedOn;
            isLedOn = swLed.checked;
            syncControlSwitches();
            if (!await sendLampCommand(requestedState) && isLedOn === requestedState) {
                isLedOn = previousState;
                swLed.checked = previousState;
                syncControlSwitches();
            }
        });

        controlsModeSwitch.addEventListener('change', () => {
            modeSwitch.checked = controlsModeSwitch.checked;
            modeSwitch.dispatchEvent(new Event('change'));
        });
        controlsPumpSwitch.addEventListener('change', () => {
            const requestedState = controlsPumpSwitch.checked;
            if (isAutoMode) {
                modeSwitch.checked = false;
                modeSwitch.dispatchEvent(new Event('change'));
            }
            swPump.checked = requestedState;
            swPump.dispatchEvent(new Event('change'));
        });
        controlsLedSwitch.addEventListener('change', () => {
            const requestedState = controlsLedSwitch.checked;
            if (isAutoMode) {
                modeSwitch.checked = false;
                modeSwitch.dispatchEvent(new Event('change'));
            }
            swLed.checked = requestedState;
            swLed.dispatchEvent(new Event('change'));
        });

        // ========== SETTINGS & LOGS ==========
        async function saveSetting(type) {
            if (type === 'soil') {
                const val = parseInt($('set-soil').value);
                try {
                    await apiRequest('/api/devices/attributes/all', {
                        method: 'PUT',
                        body: JSON.stringify({ safe_min_soil_humidity: val })
                    });
                } catch (error) {
                    addLog("Khong luu duoc nguong am dat: " + error.message, "warning");
                    return;
                }
                addLog("User thay đổi ngưỡng ẩm đất thành " + val + "%", "info");
            } else if (type === 'temp') {
                const val = parseFloat($('set-temp').value);
                addLog("Nguong canh bao nhiet do chi luu tren giao dien: " + val + " do C", "warning");
                addLog("User thay đổi ngưỡng báo nhiệt thành " + val + "°C", "warning");
            }
        }

        $('set-soil').addEventListener('input', (e) => {
            $('val-set-soil').textContent = e.target.value + "%";
        });
        $('set-temp').addEventListener('input', (e) => {
            $('val-set-temp').textContent = e.target.value + "°C";
        });

        function addLog(message, type="info") {
            const container = $('logs-container');
            const d = new Date();
            const timeStr = d.toLocaleTimeString();
            let color = "var(--on-surface-variant)";
            if(type === "warning") color = "var(--error)";
            if(type === "success") color = "var(--primary)";

            const item = document.createElement('div');
            item.style = `padding: 12px; border-bottom: 1px solid var(--outline-variant); color: ${color}; font-weight: 500;`;
            item.innerHTML = `[${timeStr}] ${message}`;
            container.prepend(item);
        }

        // ========== UPDATE UI ==========
        let prevPump = false;
        let prevWaterWarning = false;
        let prevTempWarning = false;
        let isFirstUpdate = true;

        function applyDashboardTelemetry(data) {
            if (!data) return;
            const temp = data.temperature == null ? NaN : Number(data.temperature);
            const hum = data.humidity == null ? NaN : Number(data.humidity);
            const soil = data.soil_humidity == null ? NaN : Number(data.soil_humidity);
            const water = data.water_level == null ? NaN : Number(data.water_level);
            if (Number.isFinite(temp)) {
                $('v-temp').textContent = temp.toFixed(1) + '°C';
                $('v-temp-sensor').textContent = temp.toFixed(1) + '°C';
            }
            if (Number.isFinite(hum)) {
                $('v-hum').textContent = hum.toFixed(1) + '%';
                $('v-hum-sensor').textContent = hum.toFixed(1) + '%';
            }
            if (Number.isFinite(soil)) {
                $('v-soil').textContent = Math.round(soil);
                $('v-soil-sensor').textContent = Math.round(soil) + '%';
            }
            if (Number.isFinite(water)) {
                $('v-water-display').textContent = Math.round(water) + '%';
                $('bar-water').style.width = Math.max(0, Math.min(100, water)) + '%';
                $('v-tank-sensor').textContent = Math.round(water) + '%';
            }
        }

        function updateUI(data) {
            const soil = data.soil;
            const water = data.water;
            const temp = data.temp;
            const hum = data.hum;
            const light = data.light;
            isPumpOn = data.pump;
            isLedOn = data.led;
            isAutoMode = data.auto;
            
            // Sync switches if they were changed externally
            modeSwitch.checked = isAutoMode;
            swPump.checked = isPumpOn;
            swLed.checked = isLedOn;

            // --- Event Logging ---
            if(!isFirstUpdate) {
                if(data.pump !== prevPump) {
                    if(data.pump) addLog(`Bơm ĐƯỢC BẬT (${isAutoMode ? 'Tự động' : 'Thủ công'})`, "success");
                    else addLog(`Bơm ĐÃ TẮT (${isAutoMode ? 'Tự động' : 'Thủ công'})`, "info");
                }
                if(data.water <= 10 && !prevWaterWarning) {
                    addLog("CẢNH BÁO: Mức nước quá thấp!", "warning");
                    prevWaterWarning = true;
                } else if (data.water > 10) {
                    prevWaterWarning = false;
                }
                if(data.temp > parseFloat($('set-temp').value) && !prevTempWarning) {
                    addLog("CẢNH BÁO: Nhiệt độ quá cao (" + data.temp + "°C)!", "warning");
                    prevTempWarning = true;
                } else if (data.temp <= parseFloat($('set-temp').value)) {
                    prevTempWarning = false;
                }
            }
            prevPump = data.pump;
            isFirstUpdate = false;
            // --- End Event Logging ---

            // Mode labels update
            $('mode-label').textContent = isAutoMode ? 'Tự động' : 'Thủ công';
            $('led-auto-badge').textContent = isAutoMode ? 'Tự động' : 'Thủ công';
            $('led-auto-badge').style.background = isAutoMode
                ? 'var(--primary-container)' : 'var(--tertiary-fixed)';
            $('led-auto-badge').style.color = isAutoMode
                ? 'var(--on-primary-container)' : 'var(--tertiary)';
            if (!isAutoMode) {
                swPump.style.pointerEvents = 'auto';
                swLed.style.pointerEvents = 'auto';
            } else {
                swPump.style.pointerEvents = 'none';
                swLed.style.pointerEvents = 'none';
            }

            // --- Soil Hero ---
            $('v-soil').textContent = soil;
            const soilBadge = $('soil-badge');
            if (isPumpOn) {
                soilBadge.textContent = 'Đang tưới';
                soilBadge.className = 'status-badge active';
            } else if (soil < 40 && water <= 10) {
                soilBadge.textContent = 'Lỗi';
                soilBadge.className = 'status-badge error';
            } else {
                soilBadge.textContent = 'Chế độ chờ';
                soilBadge.className = 'status-badge standby';
            }

            // --- Climate ---
            $('v-temp').textContent = temp.toFixed(1) + '°C';
            $('v-hum').textContent = hum.toFixed(1) + '%';

            const chipEl = $('climate-chip');
            if (isPumpOn && temp > 35) {
                chipEl.innerHTML = `<div class="alert-chip warning">
                    <span class="material-symbols-outlined">local_fire_department</span>
                    Tăng 20% thời gian tưới
                </div>`;
            } else if (isPumpOn && hum > 80) {
                chipEl.innerHTML = `<div class="alert-chip caution">
                    <span class="material-symbols-outlined">water</span>
                    Giảm tưới (độ ẩm cao)
                </div>`;
            } else if (temp > 35) {
                chipEl.innerHTML = `<div class="alert-chip warning">
                    <span class="material-symbols-outlined">local_fire_department</span>
                    Cảnh báo nhiệt độ cao
                </div>`;
            } else {
                chipEl.innerHTML = `<div class="alert-chip info">
                    <span class="material-symbols-outlined">check_circle</span>
                    Điều kiện bình thường
                </div>`;
            }

            // --- Lighting ---
            $('v-light').textContent = light.toLocaleString();

            // --- Water Tank ---
            const tankCard = $('card-tank');
            const tankFill = $('bar-water');
            const tankDisplay = $('v-water-display');
            const tankMsg = $('tank-msg');
            const tankIcon = $('tank-icon');

            tankDisplay.textContent = water + '%';
            tankFill.style.width = water + '%';

            if (water <= 10) {
                tankCard.className = 'card tank-card';
                tankFill.className = 'fill error';
                tankDisplay.className = 'tank-level error';
                tankIcon.textContent = 'water_lock';
                tankMsg.innerHTML = `
                    <span class="material-symbols-outlined">warning</span>
                    <span>Mực nước thấp. Đã tắt bơm để bảo vệ thiết bị.</span>`;
                tankMsg.style.color = 'var(--error)';
            } else if (water <= 25) {
                tankCard.className = 'card tank-card';
                tankFill.className = 'fill warning';
                tankDisplay.className = 'tank-level warning';
                tankIcon.textContent = 'water_lock';
                tankMsg.innerHTML = `
                    <span class="material-symbols-outlined">info</span>
                    <span>Mực nước đang xuống thấp. Hãy châm thêm nước.</span>`;
                tankMsg.style.color = 'var(--tertiary)';
            } else {
                tankCard.className = 'card tank-card normal';
                tankFill.className = 'fill';
                tankDisplay.className = 'tank-level ok';
                tankIcon.textContent = 'water_full';
                tankMsg.innerHTML = `
                    <span class="material-symbols-outlined">check_circle</span>
                    <span>Mực nước đầy đủ. Hệ thống hoạt động bình thường.</span>`;
                tankMsg.style.color = 'var(--on-surface-variant)';
            }

            // Update additional views
            if($('v-temp-sensor')) $('v-temp-sensor').textContent = temp.toFixed(1) + '°C';
            if($('v-hum-sensor')) $('v-hum-sensor').textContent = hum.toFixed(1) + '%';
            if($('v-soil-sensor')) $('v-soil-sensor').textContent = soil + '%';
            if($('v-light-sensor')) $('v-light-sensor').textContent = light.toLocaleString() + ' Lux';
            if($('v-tank-sensor')) $('v-tank-sensor').textContent = water + '%';
            if($('mode-status')) $('mode-status').textContent = isAutoMode ? 'Tự động' : 'Thủ công';
            if($('pump-status')) $('pump-status').textContent = isPumpOn ? 'Đang chạy' : 'Đã tắt';
            if($('led-status')) $('led-status').textContent = isLedOn ? 'Đang sáng' : 'Đã tắt';
            if($('schedule-mode')) $('schedule-mode').textContent = isAutoMode ? 'Tự động' : 'Thủ công';
            syncControlSwitches();

            // Notification dot duoc cap nhat tu API /api/notifications.
        }

        // ========== ASSET, DEVICE & TELEMETRY MANAGEMENT ==========
        const management = { assets: [], devices: [], telemetry: [], socket: null, historyRequest: 0 };
        const manageDialog = $('manage-dialog');
        const manageForm = $('manage-form');
        const sensorPickerDialog = $('sensor-picker-dialog');
        let sensorPickerAssetId = '';
        let sensorInitialDeviceIds = new Set();
        let sensorSelectedDeviceIds = new Set();

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[character]);
        }

        async function apiRequest(path, options = {}) {
            const response = await fetch(path, {
                ...options,
                headers: { ...(options.body ? { 'Content-Type': 'application/json' } : {}), ...options.headers }
            });
            if (response.status === 204) return null;
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || `Yeu cau that bai (${response.status})`);
            return result;
        }

        function setManagementStatus(message, state = '') {
            const status = $('management-status');
            status.textContent = message;
            status.className = `manage-status ${state}`.trim();
        }

        function formatDate(value) {
            if (!value) return 'Chưa có';
            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? 'Chưa có' : date.toLocaleString('vi-VN');
        }

        function renderAssets() {
            const body = $('assets-table-body');
            if (!management.assets.length) {
                body.innerHTML = '<tr><td class="manage-empty" colspan="5">Chưa có tài sản.</td></tr>';
                return;
            }
            body.innerHTML = management.assets.map(asset => {
                const deviceCount = management.devices.filter(device => String(device.assetId || '') === String(asset._id)).length;
                return `<tr>
                    <td>${escapeHtml(asset.name)}</td><td>${escapeHtml(asset.type || 'plant')}</td>
                    <td>${deviceCount}</td><td>${escapeHtml(formatDate(asset.createdAt))}</td>
                    <td><div class="manage-actions">
                        <button class="manage-action small" type="button" data-action="manage-sensors" data-id="${escapeHtml(asset._id)}" title="Chọn thiết bị cảm biến">Thêm cảm biến</button>
                        <button class="manage-action secondary small" type="button" data-action="edit-asset" data-id="${escapeHtml(asset._id)}" title="Sửa tài sản">Sửa</button>
                        <button class="manage-action danger small" type="button" data-action="delete-asset" data-id="${escapeHtml(asset._id)}" title="Xóa tài sản">Xóa</button>
                    </div></td>
                </tr>`;
            }).join('');
        }

        function renderSensorPicker() {
            const body = $('sensor-picker-body');
            $('sensor-selection-count').textContent = sensorSelectedDeviceIds.size;
            if (!management.devices.length) {
                body.innerHTML = '<tr><td class="manage-empty" colspan="5">Chưa có thiết bị cảm biến.</td></tr>';
                return;
            }
            body.innerHTML = management.devices.map(device => {
                const deviceId = String(device._id);
                const selected = sensorSelectedDeviceIds.has(deviceId);
                const owner = management.assets.find(asset => String(asset._id) === String(device.assetId));
                return `<tr>
                    <td>${escapeHtml(device.name)}</td>
                    <td>${escapeHtml(deviceId)}</td>
                    <td>${escapeHtml(owner?.name || 'Chưa gán')}</td>
                    <td>${device.online ? 'Online' : 'Offline'}</td>
                    <td><button class="manage-action small${selected ? ' secondary' : ''}" type="button" data-action="toggle-sensor" data-id="${escapeHtml(deviceId)}">${selected ? 'Bỏ chọn' : 'Chọn'}</button></td>
                </tr>`;
            }).join('');
        }

        function openSensorPicker(assetId) {
            const asset = management.assets.find(item => String(item._id) === String(assetId));
            if (!asset) return;
            sensorPickerAssetId = String(asset._id);
            $('sensor-picker-title').textContent = `Thêm cảm biến cho ${asset.name}`;
            sensorInitialDeviceIds = new Set(management.devices
                .filter(device => String(device.assetId || '') === sensorPickerAssetId)
                .map(device => String(device._id)));
            sensorSelectedDeviceIds = new Set(sensorInitialDeviceIds);
            renderSensorPicker();
            sensorPickerDialog.showModal();
        }

        async function saveSensorSelection() {
            console.log("Bạn vừa click thêm cảm biến cho cây");
            const selectedIds = [...sensorSelectedDeviceIds];
            try {
                await apiRequest(`/api/assets/${encodeURIComponent(sensorPickerAssetId)}/devices`, {
                    method: 'PUT',
                    body: JSON.stringify({ deviceIds: selectedIds })
                });
                const selected = new Set(selectedIds);
                management.devices = management.devices.map(device => {
                    const deviceId = String(device._id);
                    if (selected.has(deviceId)) return { ...device, assetId: sensorPickerAssetId };
                    if (sensorInitialDeviceIds.has(deviceId)) return { ...device, assetId: null };
                    return device;
                });
                sensorPickerDialog.close();
                renderAssets();
                renderDevices();
                setManagementStatus(`Đã lưu ${selectedIds.length} cảm biến cho cây.`, 'success');
            } catch (error) {
                setManagementStatus(error.message, 'error');
            }
        }

        function renderDevices() {
            const body = $('devices-table-body');
            if (!management.devices.length) {
                body.innerHTML = '<tr><td class="manage-empty" colspan="11">Chưa có thiết bị.</td></tr>';
                return;
            }
            body.innerHTML = management.devices.map(device => {
                const attributes = device.attributes || {};
                const asset = management.assets.find(item => String(item._id) === String(device.assetId));
                const minimum = attributes.safe_min_soil_humidity;
                const maximum = attributes.safe_max_soil_humidity;
                const humidityRange = minimum == null && maximum == null ? 'Chưa đặt' : `${minimum ?? '—'} - ${maximum ?? '—'}%`;
                return `<tr>
                    <td title="${escapeHtml(device._id)}">${escapeHtml(device._id)}</td>
                    <td>${escapeHtml(device.name)}</td><td>${escapeHtml(device.type)}</td>
                    <td>${escapeHtml(asset?.name || 'Chưa gán')}</td>
                    <td>${device.online ? 'Online' : 'Offline'}</td><td>${escapeHtml(device.pumpState || 'OFF')}</td>
                    <td>${escapeHtml(formatDate(device.lastSeenAt))}</td><td>${escapeHtml(attributes.firmware_version || '—')}</td>
                    <td>${escapeHtml(humidityRange)}</td><td>${attributes.flow_rate_lpm ?? '—'}</td>
                    <td><div class="manage-actions">
                        <button class="manage-action secondary small" type="button" data-action="edit-device" data-id="${escapeHtml(device._id)}" title="Sửa thiết bị">Sửa</button>
                        <button class="manage-action danger small" type="button" data-action="delete-device" data-id="${escapeHtml(device._id)}" title="Xóa thiết bị">Xóa</button>
                    </div></td>
                </tr>`;
            }).join('');
        }

        function refreshDeviceOptions() {
            const selected = $('telemetry-device-filter').value;
            $('telemetry-device-filter').innerHTML = '<option value="">Tất cả thiết bị</option>' + management.devices
                .map(device => `<option value="${escapeHtml(device._id)}">${escapeHtml(device.name)} (${escapeHtml(device._id)})</option>`).join('');
            if (management.devices.some(device => String(device._id) === selected)) $('telemetry-device-filter').value = selected;
        }

        function renderTelemetry() {
            const body = $('telemetry-table-body');
            if (!management.telemetry.length) {
                body.innerHTML = '<tr><td class="manage-empty" colspan="6">Chưa có dữ liệu telemetry.</td></tr>';
                refreshTelemetryChart();
                return;
            }
            body.innerHTML = management.telemetry.map(row => `<tr>
                <td>${escapeHtml(formatDate(row.timestamp))}</td><td>${escapeHtml(row.deviceId)}</td>
                <td>${escapeHtml(row.temperature)}</td><td>${escapeHtml(row.humidity)}</td>
                <td>${escapeHtml(row.soil_humidity)}</td><td>${escapeHtml(row.water_level)}</td>
            </tr>`).join('');
            refreshTelemetryChart();
        }

        async function loadTelemetryHistory() {
            const requestId = ++management.historyRequest;
            const selectedId = $('telemetry-device-filter').value;
            const devices = selectedId ? management.devices.filter(device => String(device._id) === selectedId) : management.devices;
            try {
                const batches = await Promise.all(devices.map(device =>
                    apiRequest(`/api/devices/${encodeURIComponent(device._id)}/telemetry?limit=50`)
                ));
                if (requestId !== management.historyRequest) return;
                management.telemetry = batches.flat().sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp)).slice(0, 50);
                if (management.telemetry[0]) applyDashboardTelemetry(management.telemetry[0]);
                renderTelemetry();
            } catch (error) {
                if (requestId === management.historyRequest) setManagementStatus(error.message, 'error');
            }
        }

        function subscribeTelemetry() {
            if (management.socket?.readyState !== WebSocket.OPEN) return;
            const selectedId = $('telemetry-device-filter').value;
            const deviceIds = selectedId ? [selectedId] : management.devices.map(device => String(device._id));
            management.socket.send(JSON.stringify({ type: 'subscribe', deviceIds }));
        }

        function connectManagementSocket() {
            const liveStatus = $('telemetry-live-status');
            const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
            const socket = new WebSocket(`${protocol}//${location.host}/ws`);
            management.socket = socket;
            socket.addEventListener('open', () => {
                liveStatus.textContent = 'Đang nhận dữ liệu';
                liveStatus.classList.add('connected');
                subscribeTelemetry();
            });
            socket.addEventListener('message', event => {
                let message;
                try { message = JSON.parse(event.data); } catch { return; }
                if (message.type === 'PUMP_STATE' && message.data) {
                    isPumpOn = message.data.state === 'ON';
                    swPump.checked = isPumpOn;
                    syncControlSwitches();
                    if ($('pump-status')) $('pump-status').textContent = isPumpOn ? 'Đang chạy' : 'Đã tắt';
                    return;
                }
                if (message.type === 'LED_STATE' && message.data) {
                    isLedOn = message.data.state === 'ON';
                    swLed.checked = isLedOn;
                    syncControlSwitches();
                    if ($('led-status')) $('led-status').textContent = isLedOn ? 'Đang sáng' : 'Đã tắt';
                    return;
                }
                if (message.type !== 'TELEMETRY' || !message.data) return;
                applyDashboardTelemetry(message.data);
                const selectedId = $('telemetry-device-filter').value;
                if (selectedId && String(message.deviceId) !== selectedId) return;
                const key = `${message.deviceId}:${message.data.timestamp}`;
                if (management.telemetry.some(row => `${row.deviceId}:${row.timestamp}` === key)) return;
                management.telemetry.unshift({ ...message.data, deviceId: message.deviceId });
                management.telemetry = management.telemetry.slice(0, 100);
                renderTelemetry();
            });
            socket.addEventListener('close', () => {
                liveStatus.textContent = 'Đang kết nối lại';
                liveStatus.classList.remove('connected');
                window.setTimeout(connectManagementSocket, 3000);
            });
            socket.addEventListener('error', () => socket.close());
        }

        async function loadManagementData() {
            try {
                const [assets, devices] = await Promise.all([
                    apiRequest('/api/assets'), apiRequest('/api/devices')
                ]);
                management.assets = assets;
                management.devices = devices;
                renderAssets();
                renderDevices();
                refreshDeviceOptions();
                setManagementStatus('');
                subscribeTelemetry();
                await loadTelemetryHistory();
            } catch (error) {
                setManagementStatus(error.message, 'error');
            }
        }

        function fieldMarkup(name, label, value = '', type = 'text', required = false, full = false, readOnly = false) {
            return `<div class="manage-field${full ? ' full' : ''}">
                <label for="manage-${name}">${escapeHtml(label)}</label>
                <input class="manage-input" id="manage-${name}" name="${escapeHtml(name)}" type="${type}" value="${escapeHtml(value)}"${required ? ' required' : ''}${readOnly ? ' readonly' : ''}>
            </div>`;
        }

        function openAssetDialog(asset = null) {
            manageDialog.dataset.kind = 'asset';
            manageDialog.dataset.id = asset?._id || '';
            $('manage-dialog-title').textContent = asset ? 'Sửa tài sản' : 'Thêm tài sản';
            $('manage-dialog-fields').innerHTML = fieldMarkup('name', 'Tên tài sản', asset?.name || '', 'text', true) +
                fieldMarkup('type', 'Loại tài sản', asset?.type || 'plant');
            manageDialog.showModal();
        }

        function openDeviceDialog(device = null) {
            manageDialog.dataset.kind = 'device';
            manageDialog.dataset.id = device?._id || '';
            $('manage-dialog-title').textContent = device ? 'Sửa thiết bị' : 'Thêm thiết bị';
            const assetOptions = '<option value="">Chưa gán tài sản</option>' + management.assets.map(asset =>
                `<option value="${escapeHtml(asset._id)}"${String(asset._id) === String(device?.assetId || '') ? ' selected' : ''}>${escapeHtml(asset.name)}</option>`
            ).join('');
            const attributes = device?.attributes || {};
            const fields = [];
            fields.push(fieldMarkup('id', 'Device ID (MQTT topic)', device?._id || '', 'text', true, true, !!device));
            fields.push(fieldMarkup('name', 'Tên thiết bị', device?.name || '', 'text', true));
            fields.push(fieldMarkup('type', 'Loại thiết bị', device?.type || 'esp32'));
            fields.push(`<div class="manage-field"><label for="manage-assetId">Tài sản</label><select class="manage-select" id="manage-assetId" name="assetId">${assetOptions}</select></div>`);
            fields.push(fieldMarkup('firmware_version', 'Phiên bản firmware', attributes.firmware_version || ''));
            fields.push(fieldMarkup('safe_min_soil_humidity', 'Ngưỡng ẩm đất tối thiểu (%)', attributes.safe_min_soil_humidity ?? '', 'number'));
            fields.push(fieldMarkup('safe_max_soil_humidity', 'Ngưỡng ẩm đất tối đa (%)', attributes.safe_max_soil_humidity ?? '', 'number'));
            fields.push(fieldMarkup('flow_rate_lpm', 'Lưu lượng (L/phút)', attributes.flow_rate_lpm ?? '', 'number'));
            fields.push('<p class="manage-hint full">Trạng thái online, bơm và thời điểm gửi cuối do thiết bị cập nhật tự động.</p>');
            $('manage-dialog-fields').innerHTML = fields.join('');
            manageDialog.showModal();
        }

        async function editDevice(deviceId) {
            try {
                const device = await apiRequest(`/api/devices/${encodeURIComponent(deviceId)}`);
                openDeviceDialog(device);
            } catch (error) {
                setManagementStatus(error.message, 'error');
            }
        }

        document.addEventListener('click', async event => {
            const button = event.target.closest('[data-action]');
            if (!button) return;
            const { action, id } = button.dataset;
            if (action === 'new-asset') openAssetDialog();
            else if (action === 'new-device') openDeviceDialog();
            else if (action === 'manage-sensors') openSensorPicker(id);
            else if (action === 'toggle-sensor') {
                if (sensorSelectedDeviceIds.has(id)) sensorSelectedDeviceIds.delete(id);
                else sensorSelectedDeviceIds.add(id);
                renderSensorPicker();
            } else if (action === 'cancel-sensor-picker') sensorPickerDialog.close();
            else if (action === 'save-sensor-picker') await saveSensorSelection();
            else if (action === 'cancel-dialog') manageDialog.close();
            else if (action === 'edit-asset') openAssetDialog(management.assets.find(asset => String(asset._id) === id));
            else if (action === 'edit-device') await editDevice(id);
            else if (action === 'delete-asset' && window.confirm('Xóa tài sản này? Thiết bị sẽ được giữ lại và bỏ liên kết tài sản.')) {
                try {
                    await apiRequest(`/api/assets/${encodeURIComponent(id)}`, { method: 'DELETE' });
                    await loadManagementData();
                        setManagementStatus('Đã xóa tài sản; thiết bị và lịch sử được giữ nguyên.', 'success');
                } catch (error) { setManagementStatus(error.message, 'error'); }
            } else if (action === 'delete-device' && window.confirm('Xóa thiết bị? Telemetry và lịch sử tưới đã lưu sẽ được giữ lại.')) {
                try {
                    await apiRequest(`/api/devices/${encodeURIComponent(id)}`, { method: 'DELETE' });
                    await loadManagementData();
                    setManagementStatus('Đã xóa thiết bị; dữ liệu lịch sử được giữ nguyên.', 'success');
                } catch (error) { setManagementStatus(error.message, 'error'); }
            }
        });

        manageForm.addEventListener('submit', async event => {
            event.preventDefault();
            const kind = manageDialog.dataset.kind;
            const id = manageDialog.dataset.id;
            const formData = new FormData(manageForm);
            let payload = Object.fromEntries(formData.entries());
            if (kind === 'device') {
                for (const field of ['safe_min_soil_humidity', 'safe_max_soil_humidity', 'safe_min_water_level', 'safe_max_water_level', 'flow_rate_lpm']) {
                    payload[field] = payload[field] === '' ? null : Number(payload[field]);
                }
            }
            const path = kind === 'asset' ? '/api/assets' : '/api/devices';
            const method = id ? 'PUT' : 'POST';
            if (id && kind === 'device') delete payload.id;
            try {
                await apiRequest(id ? `${path}/${encodeURIComponent(id)}` : path, {
                    method, body: JSON.stringify(payload)
                });
                manageDialog.close();
                await loadManagementData();
                setManagementStatus(kind === 'asset' ? 'Đã lưu tài sản.' : 'Đã lưu thiết bị và thuộc tính.', 'success');
            } catch (error) { setManagementStatus(error.message, 'error'); }
        });

        $('telemetry-device-filter').addEventListener('change', () => {
            subscribeTelemetry();
            loadTelemetryHistory();
        });

        window.addEventListener('DOMContentLoaded', () => {
            loadManagementData();
            connectManagementSocket();
        });

        // ========== LIVE TELEMETRY CHART ==========
        let telemetryChart;

        function refreshTelemetryChart() {
            if (!telemetryChart) return;
            const rows = management.telemetry.slice(0, 50).reverse();
            telemetryChart.data.labels = rows.map(row => `${new Date(row.timestamp).toLocaleTimeString('vi-VN')} · ${row.deviceId}`);
            telemetryChart.data.datasets[0].data = rows.map(row => row.soil_humidity ?? null);
            telemetryChart.data.datasets[1].data = rows.map(row => row.humidity ?? null);
            telemetryChart.data.datasets[2].data = rows.map(row => row.temperature ?? null);
            telemetryChart.update('none');
        }

        function initTelemetryChart() {
            const canvas = $('telemetryChart');
            if (!canvas || typeof Chart === 'undefined') return;
            telemetryChart = new Chart(canvas, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        { label: 'Độ ẩm đất (%)', data: [], borderColor: '#006399', backgroundColor: 'rgba(0, 99, 153, 0.08)', borderWidth: 2, pointRadius: 2, tension: 0.25 },
                        { label: 'Độ ẩm không khí (%)', data: [], borderColor: '#0f5238', backgroundColor: 'rgba(15, 82, 56, 0.08)', borderWidth: 2, pointRadius: 2, tension: 0.25 },
                        { label: 'Nhiệt độ (°C)', data: [], borderColor: '#ba1a1a', backgroundColor: 'rgba(186, 26, 26, 0.08)', borderWidth: 2, pointRadius: 2, tension: 0.25 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { position: 'bottom' } },
                    scales: { y: { beginAtZero: false }, x: { ticks: { maxTicksLimit: 8 } } }
                }
            });
            refreshTelemetryChart();
        }

        window.addEventListener('DOMContentLoaded', initTelemetryChart);
        
    </script>
</body>
</html>
