                    <a href="#" onclick="document.querySelector('[data-target=\'view-schedules\']').click()">Lịch sử & Lên lịch</a>
                    <a href="#" onclick="document.querySelector('[data-target=\'view-controls\']').click()">Cài đặt thiết bị</a>
                </div>
                <div class="footer-status">
                    <h4>Trạng thái Hệ thống</h4>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <span class="status-dot online"></span> Máy chủ Web: Ổn định
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="status-dot offline" id="footer-ws-dot"></span> WebSocket: <span id="footer-ws-text">Đang ngắt kết nối</span>
                    </div>
